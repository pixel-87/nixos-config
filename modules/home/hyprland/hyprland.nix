{
  config,
  lib,
  pkgs,
  ...
}:

let
  cfg = config.myModules.hyprland;

  # Hyprland 0.57 removed hyprlang; only hyprland.lua loads. The settings below
  # are therefore Lua API calls, rendered by Home Manager as hl.<name>(...).
  #
  # The bind helpers keep the bind list readable: every dispatcher is a Lua
  # expression, so it goes through lib.generators.mkLuaInline.
  lua = lib.generators.mkLuaInline;
  bind = key: action: {
    _args = [
      key
      (lua action)
    ];
  };
  bindWith = key: action: options: {
    _args = [
      key
      (lua action)
      options
    ];
  };
  exec = command: ''hl.dsp.exec_cmd("${command}")'';
  focusDir = direction: ''hl.dsp.focus({ direction = "${direction}" })'';
  focusWs = workspace: ''hl.dsp.focus({ workspace = "${workspace}" })'';
  moveDir = direction: ''hl.dsp.window.move({ direction = "${direction}" })'';
  moveWs = workspace: ''hl.dsp.window.move({ workspace = "${workspace}" })'';
  moveWsSilent = workspace: ''hl.dsp.window.move({ workspace = "${workspace}", follow = false })'';
  bezier = name: points: {
    _args = [
      name
      {
        type = "bezier";
        points = points;
      }
    ];
  };
in
{
  options.myModules.hyprland = {
    enable = lib.mkEnableOption "Hyprland window manager configuration";

    terminal = lib.mkOption {
      type = lib.types.str;
      default = "kitty";
      description = "Default terminal emulator";
    };

    keyboardLayout = lib.mkOption {
      type = lib.types.str;
      default = "gb";
      description = "Keyboard layout for Hyprland";
    };

    gapsIn = lib.mkOption {
      type = lib.types.int;
      default = 5;
      description = "Inner gaps between windows";
    };

    gapsOut = lib.mkOption {
      type = lib.types.int;
      default = 10;
      description = "Outer gaps from screen edges";
    };

    borderSize = lib.mkOption {
      type = lib.types.int;
      default = 2;
      description = "Window border size";
    };
  };

  config = lib.mkIf cfg.enable {
    wayland.windowManager.hyprland = {
      enable = true;
      configType = "lua";

      settings = {
        config = {
          autogenerated = 0;

          general = {
            gaps_in = cfg.gapsIn;
            gaps_out = cfg.gapsOut;
            border_size = cfg.borderSize;
            "col.active_border" = lib.mkForce "rgba(ffffffee)";
            "col.inactive_border" = lib.mkForce "rgba(595959aa)";
          };

          decoration = {
            rounding = 10;

            blur = {
              enabled = true;
              size = 8;
              passes = 3;
              new_optimizations = true;
              ignore_opacity = false;
              xray = false;
            };
          };

          input = {
            kb_layout = cfg.keyboardLayout;
            follow_mouse = 1;
          };

          dwindle = {
            preserve_split = true;
          };
        };

        monitor = [
          {
            output = "";
            mode = "preferred";
            position = "auto";
            scale = 1;
          }
        ];

        device = [
          {
            name = "diego-palacios-cantor";
            kb_layout = "us";
          }
          {
            name = "diego-palacios-cantor-keyboard";
            kb_layout = "us";
          }
          {
            name = "diego-palacios-cantor-system-control";
            kb_layout = "us";
          }
          {
            name = "diego-palacios-cantor-consumer-control";
            kb_layout = "us";
          }
        ];

        curve = [
          (bezier "wind" [
            [
              0.05
              0.9
            ]
            [
              0.1
              1.05
            ]
          ])
          (bezier "winIn" [
            [
              0.1
              1.1
            ]
            [
              0.1
              1.1
            ]
          ])
          (bezier "winOut" [
            [
              0.3
              (-0.3)
            ]
            [
              0
              1
            ]
          ])
          (bezier "liner" [
            [
              1
              1
            ]
            [
              1
              1
            ]
          ])
        ];

        animation = [
          {
            leaf = "windows";
            enabled = true;
            speed = 6;
            bezier = "wind";
            style = "slide";
          }
          {
            leaf = "windowsIn";
            enabled = true;
            speed = 6;
            bezier = "winIn";
            style = "slide";
          }
          {
            leaf = "windowsOut";
            enabled = true;
            speed = 5;
            bezier = "winOut";
            style = "slide";
          }
          {
            leaf = "windowsMove";
            enabled = true;
            speed = 5;
            bezier = "wind";
            style = "slide";
          }
          {
            leaf = "border";
            enabled = true;
            speed = 1;
            bezier = "liner";
          }
          {
            leaf = "borderangle";
            enabled = true;
            speed = 30;
            bezier = "liner";
            style = "loop";
          }
          {
            leaf = "fade";
            enabled = true;
            speed = 10;
            bezier = "default";
          }
          {
            leaf = "workspaces";
            enabled = true;
            speed = 5;
            bezier = "wind";
          }
        ];

        # Old exec-once list.
        on = [
          {
            _args = [
              "hyprland.start"
              (lua ''
                function()
                  hl.exec_cmd("nm-applet --indicator")
                  hl.exec_cmd("blueman-applet")
                  hl.exec_cmd("${cfg.terminal}")
                end
              '')
            ];
          }
        ];

        window_rule = [
          {
            match.class = ".*";
            opacity = "0.95 0.75";
          }
        ];

        bind = [
          (bind "SUPER + F1" (exec "show-keybinds"))
          (bind "SUPER + space" (exec "toggle-float"))

          (bind "SUPER + Q" (exec cfg.terminal))
          (bind "SUPER + C" "hl.dsp.window.close()")
          (bind "SUPER + M" "hl.dsp.exit()")
          (bind "SUPER + E" (exec "nautilus"))
          (bind "SUPER + V" ''hl.dsp.window.float({ action = "toggle" })'')
          (bind "SUPER + R" (exec "noctalia msg panel-toggle launcher"))
          (bind "SUPER + P" "hl.dsp.window.pseudo()")
          (bind "SUPER + F" (exec "zen"))

          (bind "SUPER + left" (focusDir "left"))
          (bind "SUPER + right" (focusDir "right"))
          (bind "SUPER + up" (focusDir "up"))
          (bind "SUPER + down" (focusDir "down"))
          (bind "SUPER + h" (focusDir "left"))
          (bind "SUPER + j" (focusDir "down"))
          (bind "SUPER + k" (focusDir "up"))
          (bind "SUPER + l" (focusDir "right"))

          (bind "SUPER + X" ''hl.dsp.window.fullscreen({ mode = "fullscreen" })'')
          (bind "SUPER + SHIFT + X" ''hl.dsp.window.fullscreen({ mode = "maximized" })'')

          (bind "CTRL + ALT + up" ''hl.dsp.focus({ window = "floating" })'')
          (bind "CTRL + ALT + down" ''hl.dsp.focus({ window = "tiled" })'')

          (bind "SUPER + CTRL + c" (moveWs "empty"))

          (bind "SUPER + S" ''hl.dsp.workspace.toggle_special("magic")'')
          (bind "SUPER + SHIFT + S" (moveWs "special:magic"))

          (bind "SUPER + mouse_down" (focusWs "e+1"))
          (bind "SUPER + mouse_up" (focusWs "e-1"))

          (bind "SUPER + SHIFT + left" (moveDir "left"))
          (bind "SUPER + SHIFT + right" (moveDir "right"))
          (bind "SUPER + SHIFT + up" (moveDir "up"))
          (bind "SUPER + SHIFT + down" (moveDir "down"))
          (bind "SUPER + SHIFT + h" (moveDir "left"))
          (bind "SUPER + SHIFT + j" (moveDir "down"))
          (bind "SUPER + SHIFT + k" (moveDir "up"))
          (bind "SUPER + SHIFT + l" (moveDir "right"))

          (bind "XF86AudioMute" (exec "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"))
          (bind "XF86AudioMicMute" (exec "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"))
          (bind "XF86MonBrightnessUp" (exec "brightnessctl set 5%+"))
          (bind "XF86MonBrightnessDown" (exec "brightnessctl set 5%-"))

          (bind "XF86AudioNext" (exec "playerctl next"))
          (bind "XF86AudioPause" (exec "playerctl play-pause"))
          (bind "XF86AudioPlay" (exec "playerctl play-pause"))
          (bind "XF86AudioPrev" (exec "playerctl previous"))

          (bindWith "SUPER + mouse:272" "hl.dsp.window.drag()" { drag = true; })
          (bindWith "SUPER + mouse:273" "hl.dsp.window.resize()" { drag = true; })

          (bind "SUPER + SHIFT + P" (exec "screenshot area"))
          (bind "SUPER + CTRL + P" (exec "screenshot window"))
          (bind "SUPER + ALT + P" (exec "screenshot edit"))

          (bind "SUPER + ALT + W" (exec "noctalia msg panel-toggle wallpaper"))
          (bind "SUPER + CTRL + right" (exec "noctalia msg wallpaper-next"))
          (bind "SUPER + CTRL + left" (exec "noctalia msg wallpaper-previous"))
        ]
        ++ lib.concatMap (
          number:
          let
            key = "code:${toString (9 + number)}";
            ws = toString number;
          in
          [
            (bind "SUPER + ${key}" (focusWs ws))
            (bind "SUPER + SHIFT + ${key}" (moveWsSilent ws))
          ]
        ) (lib.range 1 9)
        ++ [
          (bindWith "XF86AudioRaiseVolume" (exec "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+") {
            locked = true;
          })
          (bindWith "XF86AudioLowerVolume" (exec "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-") {
            locked = true;
          })
        ];
      };
    };
  };
}
